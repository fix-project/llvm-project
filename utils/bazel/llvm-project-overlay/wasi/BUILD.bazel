load(":cc_toolchain_config.bzl", "sysroot_flag", "wasi_cc_toolchain_config")
load("@rules_cc//cc:defs.bzl", "cc_toolchain")

package(default_visibility = ["//visibility:public"])

sysroot_flag(
    name = "sysroot",
    build_setting_default = "",
)

platform(
    name = "wasm32_wasip1",
    constraint_values = [
        "@platforms//os:wasi",
        "@platforms//cpu:wasm32",
    ],
)

wasi_cc_toolchain_config(
    name = "config",
    clang = "@wasi_toolchain//:tools/cc",
    clangxx = "@wasi_toolchain//:tools/cxx",
    ld = "@wasi_toolchain//:tools/ld",
    ar = "@wasi_toolchain//:tools/ar",
    nm = "@wasi_toolchain//:tools/nm",
    objcopy = "@wasi_toolchain//:tools/objcopy",
    objdump = "@wasi_toolchain//:tools/objdump",
    strip = "@wasi_toolchain//:tools/strip",
)

cc_toolchain(
    name = "cc_toolchain_impl",
    toolchain_identifier = "llvm-wasm32-wasip1",
    toolchain_config = ":config",
    all_files = "@wasi_toolchain//:files",
    ar_files = "@wasi_toolchain//:linker_files",
    as_files = "@wasi_toolchain//:compiler_files",
    compiler_files = "@wasi_toolchain//:compiler_files",
    dwp_files = "@wasi_toolchain//:linker_files",
    linker_files = "@wasi_toolchain//:linker_files",
    objcopy_files = "@wasi_toolchain//:linker_files",
    strip_files = "@wasi_toolchain//:linker_files",
    supports_param_files = 1,
)

toolchain(
    name = "cc_toolchain",
    toolchain = ":cc_toolchain_impl",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:wasi",
        "@platforms//cpu:wasm32",
    ],
)
