#ifndef _LLVM_LIBC_SYS_TYPES_H
#define _LLVM_LIBC_SYS_TYPES_H

#include "../__llvm-libc-common.h"

%%public_api()

// WASI applications commonly obtain the descriptor set and select declaration
// through <sys/types.h>, as they do with wasi-libc.
#ifdef __wasi__
#include "select.h"
#endif

